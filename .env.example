# AiAura Platform
AIAURA_API_URL=https://api.aiaura.me/v1
AIAURA_API_KEY=your_aiaura_token

# ServiceNow & Jira
SERVICENOW_INSTANCE=your-instance.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=secret
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER=admin@domain.com
JIRA_API_TOKEN=your_jira_token

# SIEM & Vulnerability Scanners
SPLUNK_HOST=https://splunk.yourdomain.com:8089
SPLUNK_TOKEN=your_splunk_hec_or_auth_token
SENTINEL_WORKSPACE_ID=your_log_analytics_workspace_id
SENTINEL_TENANT_ID=your_azure_tenant_id
TENABLE_ACCESS_KEY=your_tenable_access_key
TENABLE_SECRET_KEY=your_tenable_secret_key
QUALYS_API_URL=https://qualysapi.qualys.com
QUALYS_AUTH_TOKEN=your_qualys_token

# EDR (e.g. SentinelOne / Wazuh)
EDR_BASE_URL=https://your-edr.domain.com/web/api/v2.1
EDR_API_TOKEN=your_edr_api_token

# Cloud Providers
AWS_REGION=us-east-1
AZURE_SUBSCRIPTION_ID=your-subscription-id
GCP_PROJECT_ID=your-gcp-project-id

# Collaboration
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Network & Infra
F5_HOST=10.0.0.1
F5_USER=admin
F5_PASSWORD=secret
CISCO_DEVICE_IP=10.0.0.2
CISCO_USERNAME=admin
CISCO_PASSWORD=secret
NGINX_STATUS_URL=http://localhost:8080/nginx_status
